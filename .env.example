# Forge credentials — copy to .env and fill in locally. Never commit .env.

# OpenAI reflection/planner provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano

# TensorMux (hackathon inference, OpenAI-compatible)
TENSORMUX_API_KEY=
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_WORKER_MODEL=glm-4-7-flash

# Strong model for planner / verifier / learning (OpenAI-compatible endpoint)
STRONG_MODEL_BASE_URL=
STRONG_MODEL_API_KEY=
STRONG_MODEL_ID=

# Supermemory (future skill/context mirror)
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER=forge:default

# GitHub fine-grained PAT — demo target repo only
GITHUB_PAT=

# AO daemon loopback
AO_DAEMON_URL=http://127.0.0.1:3001

# Neatlogs observability
NEATLOGS_API_KEY=
