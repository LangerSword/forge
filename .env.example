# Forge credentials — copy to .env and fill in. NEVER commit .env.

# TensorMux (hackathon inference, OpenAI-compatible)
TENSORMUX_API_KEY=tmx_...
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_WORKER_MODEL=glm-4-7-flash

# Strong model for planner / verifier / learning (OpenAI-compatible endpoint)
STRONG_MODEL_BASE_URL=
STRONG_MODEL_API_KEY=
STRONG_MODEL_ID=

# Supermemory (skill/context mirror)
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER=forge:default

# GitHub fine-grained PAT — scope: the demo target repo only
GITHUB_PAT=

# AO daemon loopback
AO_DAEMON_URL=http://127.0.0.1:3037

# Neatlogs (optional)
NEATLOGS_API_KEY=
